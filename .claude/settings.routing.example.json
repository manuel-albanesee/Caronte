{
  "model": "claude-sonnet-5-5",
  "effortLevel": "medium",
  "autoCompactEnabled": true,
  "autoCompactWindow": 200000,
  "env": {
    "CLAUDE_CODE_FORK_SUBAGENT": "0"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Agent|Task)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/validate-agent-brief.cjs"
            ],
            "timeout": 20,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "^(Bash|PowerShell|Monitor|Skill|Write|Edit|MultiEdit|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/enforce-worker.cjs"
            ],
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/suggest-skills.cjs"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/delegation-context.cjs"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/compact-focus.cjs"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/sync-dependencies.cjs"
            ],
            "timeout": 125
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/record-telemetry.cjs"
            ],
            "timeout": 5
          }
        ],
        "matcher": "^(Agent|Task|Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit|Monitor|Skill)$"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/record-telemetry.cjs"
            ],
            "timeout": 5
          }
        ],
        "matcher": "^(Agent|Task|Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit|Monitor|Skill)$"
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/record-telemetry.cjs"
            ],
            "timeout": 5
          }
        ],
        "matcher": "^(Agent|Task|Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit|Monitor|Skill)$"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/record-telemetry.cjs"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/record-telemetry.cjs"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
